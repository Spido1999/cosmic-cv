# ============================================================
# ATS Resume Builder - Environment Configuration
# ============================================================

# --- OpenAI (Required) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o          # gpt-4o | gpt-4-turbo | gpt-3.5-turbo

# --- Optional: Anthropic Claude (fallback model) ---
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- LaTeX Compiler (set path if MiKTeX/TeX Live installed locally) ---
# Leave blank to use online fallback (latexonline.cc)
LATEX_COMPILER_PATH=          # e.g. C:\Users\You\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe

# --- Output Directory ---
OUTPUT_DIR=output
